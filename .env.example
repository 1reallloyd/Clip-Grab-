# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- ClipGrab Backend Configuration ---
# Comma-separated domains to block (e.g. from DMCA / takedown requests)
BLOCKED_DOMAINS=""

# Maximum requests per minute per client IP
RATE_LIMIT_PER_MIN="10"

# Maximum video/audio duration in seconds (default: 3600 = 60 minutes)
MAX_DURATION_SEC="3600"

# Maximum downloadable file size in MB (default: 500)
MAX_FILE_SIZE_MB="500"

# Restrict CORS to your exact origin (leave empty for same-origin only)
ALLOWED_ORIGIN=""

# Logging verbosity (INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# Optional path to Netscape-format cookies.txt for platforms requiring sign-in/bot bypass
YTDLP_COOKIES_FILE=""

# Or paste raw Netscape-format cookies content directly (useful in cloud Secrets)
YTDLP_COOKIES_CONTENT=""
